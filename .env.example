# ZylCode — developer environment template
#
# Copy to `.env` and edit. `.env` is git-ignored (`.gitignore` lines 35-37);
# this file is the committed template and must never contain a real value.
#
# Every entry below was validated against the source that reads it — the
# `file:line` reference is the exact read site, and the documented default is
# the value the code falls back to when the variable is unset. Nothing here is
# guessed.
#
# NOTHING in this file is required. ZylCode runs fully offline by default:
# with no provider credential configured, `TokenRouter::dispatch_prompt`
# short-circuits to the deterministic synthetic provider. Set a provider key
# only when you intend to make real, billed provider calls.

# ---------------------------------------------------------------------------
# Model provider credentials — OPTIONAL
# ---------------------------------------------------------------------------
# Read by `RouterConfig::api_key` (crates/zylcode-core/src/router.rs:404-423),
# which falls back to these environment variables when no key is configured in
# `api_keys`. Leaving them unset selects the offline synthetic path.
#
# WARNING — these affect tests, not just the CLI. `RouterConfig::default()`
# sets `fallback_provider: LocalOllama`, which makes the no-keys fast path's
# `both_need_keys` guard false, so a dispatch with no configured credential
# still attempts the primary provider and then its Ollama fallback. With any of
# these set, `pipeline_offline_generates_artifacts_and_passes_verification`
# performs real HTTP requests during `cargo test`. Leave them unset for a
# hermetic offline test run.

# OpenRouter — primary provider in the default config.
OPENROUTER_API_KEY=

# Anthropic — fallback provider in the default config.
ANTHROPIC_API_KEY=

# DeepSeek — reachable through the configured provider chain.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Model selection — OPTIONAL
# ---------------------------------------------------------------------------
# Read by `RouterConfig::from_env` (crates/zylcode-core/src/router.rs:444-452).

# Overrides `RouterConfig::default().primary_model`
# ("anthropic/claude-3.5-sonnet").
ZYLCODE_PRIMARY_MODEL=

# Overrides `RouterConfig::default().fallback_model` ("llama3.1").
ZYLCODE_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# Local state locations — OPTIONAL
# ---------------------------------------------------------------------------
# Every one of these has a working default; set them only to relocate state
# (for example to keep it out of a repository checkout). Defaults are the
# documented fallback in the source, not an assumption.

# Vector cache. Default: `~/.zylcode/vector_cache.db`, then `./vector_cache.db`.
#   crates/zylcode-core/src/cache.rs:133
ZYLCODE_VECTOR_CACHE_PATH=

# Provider scorecard. Default: `~/.zylcode/provider_scorecard.db`.
#   crates/zylcode-core/src/router.rs:601
ZYLCODE_SCORECARD_PATH=

# Repository-intelligence index cache.
# Default: `<workspace-root>/.zylcode/intelligence-index.json`.
#   crates/zylcode-core/src/intelligence/persisted.rs:68
ZYLCODE_INTELLIGENCE_CACHE=

# Telemetry database (desktop app).
#   apps/zylcode-desktop/src-tauri/src/main.rs:1021
ZYLCODE_TELEMETRY_DB_PATH=

# MCP tool configuration file. Default: `mcp.tools.yaml` if present, else none.
#   crates/zylcode-mcp/src/lib.rs:77
ZYLCODE_MCP_CONFIG=

# Evidence log (MCP evidence recorder).
#   crates/zylcode-mcp/src/evidence.rs:95
ZYLCODE_EVIDENCE_LOG=

# Factory job queue. Default: `<workspace-root>/.zylcode/factory/jobs`.
#   crates/zylcode-core/src/factory/store.rs:25
FACTORY_JOBS_DIR=

# Artifact Bus index + data. Default: `<workspace-root>/.zylcode/artifacts`.
#   crates/zylcode-core/src/artifact_bus.rs:219
ARTIFACTS_DIR=

# Claims ledger. Default: `<workspace-root>/.zylcode/claims.json`.
#   crates/zylcode-core/src/claim.rs:357
CLAIMS_PATH=

# Evidence graph. Default: `<workspace-root>/.zylcode/evidence_graph.json`.
#   crates/zylcode-core/src/evidence_graph.rs:234
EVIDENCE_GRAPH_PATH=

# Proof ledger. Default: `<workspace-root>/.zylcode/proofs.json`.
#   crates/zylcode-core/src/proof_engine.rs:170
PROOFS_PATH=

# Project store. Default: `<workspace-root>/.zylcode/projects.json`.
#   crates/zylcode-core/src/project_store.rs:127
PROJECTS_PATH=

# ---------------------------------------------------------------------------
# Test / diagnostics — OPTIONAL
# ---------------------------------------------------------------------------

# First-Mission crash injection. Set to a step name to interrupt the run at
# that step and exercise the resume path. Leave unset for a normal run.
#   crates/zylcode-cli/src/main.rs:1814
ZYLCODE_MISSION_CRASH_AT=

# ---------------------------------------------------------------------------
# Release only — OPTIONAL, never commit a value
# ---------------------------------------------------------------------------

# crates.io publishing token. Only its *presence* is read, by
# `deploy-status`; the value is never read or returned.
#   crates/zylcode-core/src/delivery.rs:285
CARGO_REGISTRY_TOKEN=
